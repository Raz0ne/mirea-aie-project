# Example environment file for the credit-scoring service.
# Copy this file to `.env` at the project root and adjust values.
# Real `.env` must NOT be committed (see .gitignore).

APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Path to trained model artifact (joblib bundle)
MODEL_PATH=artifacts/model.joblib

# Decision threshold for /predict (probability >= threshold -> "reject")
DECISION_THRESHOLD=0.5

# Random seed for reproducibility
RANDOM_SEED=42
