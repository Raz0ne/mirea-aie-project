# Пример файла окружения для сервиса кредитного скоринга.
# Скопируйте этот файл в `.env` в корень проекта и подкорректируйте значения.
# Реальный `.env` коммитить НЕЛЬЗЯ (см. .gitignore).

APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Путь к обученному артефакту модели (joblib-бандл)
MODEL_PATH=artifacts/model.joblib

# Порог решения для /predict (вероятность >= threshold -> "reject")
DECISION_THRESHOLD=0.5

# Сид для воспроизводимости
RANDOM_SEED=42
